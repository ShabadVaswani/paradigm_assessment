# Copy to .env (gitignored). A variable already set in your environment wins over this file.

# Needed to generate answers. If it is not set, the app asks for a key at startup (used for that session only).
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown)
# ANSWER_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-opus-5-5
# IMAGE_MODEL=claude-sonnet-5-5
