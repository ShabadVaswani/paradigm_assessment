# Copy to .env (gitignored) and fill in what you use; leave the rest empty.
# Variables already set in your shell take precedence over this file.

# --- Claude: pick ONE way to authenticate -------------------------------------------------------------------
# Option A: the API key is stored in Azure Key Vault, read with DefaultAzureCredential (e.g. after `az login`).
# Vault URL, e.g. https://my-vault.vault.azure.net/
AZURE_KEY_VAULT_URL=
ANTHROPIC_KEY_SECRET_NAME=anthropic-api-key

# Option B: the API key directly.
ANTHROPIC_API_KEY=

# Platform: "anthropic" (Claude API) or "foundry" (Claude on Microsoft Foundry).
LLM_PROVIDER=anthropic
# Foundry only: the resource name. The key can still come from Key Vault, or from ANTHROPIC_FOUNDRY_API_KEY.
ANTHROPIC_FOUNDRY_RESOURCE=

# --- Models (defaults shown) ---------------------------------------------------------------------------------
# ANSWER_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-opus-5-5
# IMAGE_MODEL=claude-sonnet-5-5
